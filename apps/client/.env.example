# ============================================================================
# Peak — environment configuration
# Copy to .env.local for local dev. Set the same variables in your host (Vercel,
# Fly, Railway, etc.) for production. Do NOT commit .env.local.
# ============================================================================

# ----------------------------------------------------------------------------
# Database — Postgres (use Neon's free tier for the fastest setup)
# ----------------------------------------------------------------------------
# Neon (https://neon.tech) — free tier, branchable, generous limits.
# Sign up, create a project, copy the pooled connection string. Looks like:
#   postgres://USER:PASS@ep-xxx-pooler.us-east-1.aws.neon.tech/peak?sslmode=require
# Alternatively, run a local Postgres with: docker compose up -d
DATABASE_URL="postgres://peak:peak@localhost:5432/peak?schema=public"

# ----------------------------------------------------------------------------
# NextAuth
# ----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate_with_openssl_rand_base64_32"
NEXTAUTH_URL="http://localhost:3000"

# ----------------------------------------------------------------------------
# Email (NextAuth EmailProvider — magic-link sign-in)
# ----------------------------------------------------------------------------
# Recommended provider: Resend (https://resend.com). Their SMTP relay works
# out-of-the-box; free tier is plenty for v0.
#   host: smtp.resend.com
#   port: 587
#   user: resend
#   password: <your Resend API key>
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="user"
EMAIL_SERVER_PASSWORD="pass"
EMAIL_FROM="Peak <noreply@peak.local>"

# ----------------------------------------------------------------------------
# Stripe — payments + Connect
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Platform fee in basis points. 1000 = 10%.
PLATFORM_FEE_BPS="1000"

# ----------------------------------------------------------------------------
# Maps — Mapbox token for the map view
# ----------------------------------------------------------------------------
# Free tier (50K map loads/month) covers v0. Sign up at https://mapbox.com.
NEXT_PUBLIC_MAPBOX_TOKEN=""
