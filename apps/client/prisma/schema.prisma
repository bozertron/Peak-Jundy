datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// Identity
// ----------------------------------------------------------------------------

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  stripeAccountId String?   @unique
  role            String    @default("USER")

  // Peak profile extensions
  avatarUrl      String?
  bio            String?
  flavor         String?
  memberSince    DateTime @default(now())
  foundingMember Boolean  @default(false)
  latitude       Float?
  longitude      Float?
  locationName   String?
  peaksBalance   Int      @default(0)

  accounts  Account[]
  sessions  Session[]
  equipment Equipment[]
  rentals   Booking[]   @relation("RenterBookings")

  // Trust network
  vouchesGiven    Vouch[] @relation("VouchesGiven")
  vouchesReceived Vouch[] @relation("VouchesReceived")

  // Contact cards
  cardsCollected  ContactCard[] @relation("CardsCollected")
  cardsAppearedIn ContactCard[] @relation("CardsAppearedIn")

  // Conversations + messages
  conversations Conversation[] @relation("ConversationParticipants")
  messagesSent  Message[]      @relation("MessagesSent")

  // Peaks economy
  peaksTransactions PeaksTransaction[]
  chestsClaimed     TreasureChest[]    @relation("ChestsClaimed")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// Marketplace
// ----------------------------------------------------------------------------

model Equipment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String
  specs       String // JSON string
  category    String
  ownerId     String
  dailyRate   Int // In cents
  available   Boolean @default(true)
  hourMeter   Float?
  image       String?
  location    String?

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  conversations Conversation[]

  @@index([ownerId])
  @@index([category])
  @@index([location])
}

model Booking {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  cancelledAt        DateTime?
  cancellationReason String?

  equipmentId     String
  renterId        String
  startDate       DateTime
  endDate         DateTime
  totalPrice      Int // cents
  status          String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  stripeSessionId String?  @unique

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  renter    User      @relation("RenterBookings", fields: [renterId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([renterId])
  @@index([status])
}

model SearchLog {
  id        Int      @id @default(autoincrement())
  query     String
  userId    String?
  timestamp DateTime @default(now())
  fulfilled Boolean  @default(false)

  @@index([fulfilled])
  @@index([query])
}

// ----------------------------------------------------------------------------
// Trust network
// ----------------------------------------------------------------------------

model Vouch {
  id          String    @id @default(cuid())
  voucherId   String
  voucheeId   String
  note        String?
  broadcast   Boolean   @default(false)
  broadcastAt DateTime?
  createdAt   DateTime  @default(now())

  voucher User @relation("VouchesGiven", fields: [voucherId], references: [id], onDelete: Cascade)
  vouchee User @relation("VouchesReceived", fields: [voucheeId], references: [id], onDelete: Cascade)

  @@unique([voucherId, voucheeId])
  @@index([voucherId])
  @@index([voucheeId])
  @@index([broadcast])
}

model ContactCard {
  id          String   @id @default(cuid())
  collectorId String
  subjectId   String
  origin      String // "vouch" | "conversation" | "rental" | "manual"
  createdAt   DateTime @default(now())

  collector User @relation("CardsCollected", fields: [collectorId], references: [id], onDelete: Cascade)
  subject   User @relation("CardsAppearedIn", fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([collectorId, subjectId])
  @@index([collectorId])
  @@index([subjectId])
}

// ----------------------------------------------------------------------------
// Communications
// ----------------------------------------------------------------------------

model Conversation {
  id          String   @id @default(cuid())
  equipmentId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants User[]     @relation("ConversationParticipants")
  equipment    Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  messages     Message[]

  @@index([equipmentId])
  @@index([updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  delivered      Boolean  @default(true)
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ----------------------------------------------------------------------------
// Peaks economy
// ----------------------------------------------------------------------------

model PeaksTransaction {
  id            String   @id @default(cuid())
  userId        String
  amount        Int // can be negative (chest claims)
  reason        String // "vouch_given" | "vouch_broadcast" | "rental_complete" | "first_interaction" | "profile_complete" | "referral" | "founding_member" | "chest_claim" | ...
  referenceId   String?
  referenceType String? // "vouch" | "booking" | "treasure_chest" | "conversation" | ...
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([reason])
}

model TreasureChest {
  id          String    @id @default(cuid())
  title       String
  description String
  peaksCost   Int
  prizeType   String // "discount" | "physical_item" | "feature_unlock" | "badge" | ...
  prizeValue  String?
  available   Boolean   @default(true)
  claimedBy   String?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())

  claimer User? @relation("ChestsClaimed", fields: [claimedBy], references: [id], onDelete: SetNull)

  @@index([available])
  @@index([claimedBy])
}
